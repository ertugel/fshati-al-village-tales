        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "zone": {
              "description": "Filter by zone (e.g. 'Alps', 'Riviera', 'Berat').",
              "type": "string"
            },
            "type": {
              "description": "Filter by accommodation type.",
              "type": "string"
            },
            "featured": {
              "description": "Only featured destinations.",
              "type": "boolean"
            },
            "limit": {
              "description": "Max results (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_tours",
        "title": "List tours",
